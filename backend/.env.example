# YouthCamping Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production
API_TIMEOUT=3000
RATE_LIMIT_WINDOW=60000

# Database Connections (Supabase PostgreSQL Connection String)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
TEST_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres_test"

# Security & JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
ENCRYPTION_SECRET="your_encryption_secret_here"
BOOKING_LINK_SECRET="your_booking_link_secret_here"

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:3000,https://youthcamping.online,https://admin.youthcamping.online"
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Monitoring & Logging
DISABLE_RATE_LIMIT=false
ENABLE_PERFORMANCE_METRICS=false

# Email & Notifications
BREVO_API_KEY="your_brevo_api_key_here"
EMAIL_FROM="noreply@example.com"
INTERNAL_EMAIL_BCC="ops@example.com,finance@example.com"

# AI & Integrations
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/your_script_id/exec"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# File Uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# Caching
REDIS_URL="redis://localhost:6379"

# Admin Access
SUPERADMIN_EMAILS="founder@example.com,admin@example.com"

# Local/Test Safety Flags
ALLOW_LOCAL_STORAGE=false
ALLOW_PRODUCTION_DATABASE=false
ALLOW_MUTATING_TESTS=false
ISOLATED_TEST_DATABASE_HOSTS="localhost,127.0.0.1"
