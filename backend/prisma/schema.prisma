model TravelDeskWorkspace {
  id              String               @id @default(cuid())
  tripId          String               @unique
  status          String               @default("ACTIVE")
  readinessScore  Float?
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  trip            Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  categories      TravelDeskCategory[]
  articles        TravelDeskArticle[]
  vendorLinks     TravelDeskVendorLink[]
  notices         TravelDeskNotice[]
  learnings       TravelDeskLearning[]
  auditLogs       TravelDeskAuditLog[]

  @@index([tripId])
}

model TravelDeskCategory {
  id              String               @id @default(cuid())
  workspaceId     String
  name            String
  slug            String
  description     String?
  sortOrder       Int                  @default(0)
  isRequired      Boolean              @default(false)
  isActive        Boolean              @default(true)

  workspace       TravelDeskWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles        TravelDeskArticle[]

  @@index([workspaceId])
}

model TravelDeskArticle {
  id              String               @id @default(cuid())
  workspaceId     String
  categoryId      String
  title           String
  summary         String?
  content         String               @db.Text
  tags            Json?
  status          String               @default("DRAFT")
  visibility      String               @default("INTERNAL")
  ownerId         String?
  version         Int                  @default(1)
  effectiveFrom   DateTime?
  expiresAt       DateTime?
  approvedById    String?
  publishedById   String?
  createdById     String?
  updatedById     String?
  originLearningId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace       TravelDeskWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category        TravelDeskCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  originLearning  TravelDeskLearning?  @relation(fields: [originLearningId], references: [id], onDelete: SetNull)
  versions        TravelDeskArticleVersion[]

  @@index([workspaceId])
  @@index([categoryId])
  @@index([status])
}

model TravelDeskArticleVersion {
  id              String               @id @default(cuid())
  articleId       String
  version         Int
  title           String
  summary         String?
  content         String               @db.Text
  categoryId      String
  tags            Json?
  visibility      String
  status          String
  effectiveFrom   DateTime?
  expiresAt       DateTime?
  ownerId         String?
  authorId        String?
  changeComment   String?
  createdAt       DateTime             @default(now())

  article         TravelDeskArticle    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
}

model TravelDeskVendorLink {
  id              String               @id @default(cuid())
  workspaceId     String
  vendorId        String
  departureDate   String?              // Soft reference to a departure date string (e.g. "YYYY-MM-DD")
  itineraryDayId  String?
  relationshipType String              // e.g., "HOTEL", "TRANSPORT"
  negotiatedRate  Float?
  validFrom       DateTime?
  validUntil      DateTime?
  internalNotes   String?
  isPreferred     Boolean              @default(false)
  isBackup        Boolean              @default(false)
  status          String               @default("ACTIVE")

  workspace       TravelDeskWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([vendorId])
  @@index([departureDate])
}

model TravelDeskNotice {
  id                     String               @id @default(cuid())
  workspaceId            String?
  departureDate          String?              // Soft reference
  title                  String
  message                String               @db.Text
  type                   String               // e.g., "GLOBAL", "TRIP_WISE", "DEPARTURE_WISE"
  priority               String               // e.g., "LOW", "NORMAL", "HIGH", "CRITICAL"
  audienceRoles          Json?                // Array of strings
  requiresAcknowledgement Boolean             @default(false)
  publishedAt            DateTime?
  expiresAt              DateTime?
  status                 String               @default("ACTIVE")

  workspace              TravelDeskWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  acks                   TravelDeskNoticeAck[]

  @@index([workspaceId])
  @@index([departureDate])
  @@index([status])
}

model TravelDeskNoticeAck {
  id             String               @id @default(cuid())
  noticeId       String
  userId         String
  acknowledgedAt DateTime             @default(now())

  notice         TravelDeskNotice     @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId, acknowledgedAt])
}

model TravelDeskLearning {
  id              String               @id @default(cuid())
  workspaceId     String
  departureDate   String               // Soft reference
  category        String               // e.g., "VENDOR", "ITINERARY", "CUSTOMER_FEEDBACK"
  issue           String               @db.Text
  rootCause       String?              @db.Text
  resolution      String?              @db.Text
  recommendation  String?              @db.Text
  severity        String               // e.g., "LOW", "MEDIUM", "HIGH"
  status          String               @default("OPEN")
  ownerId         String?

  workspace       TravelDeskWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles        TravelDeskArticle[]

  @@index([workspaceId])
  @@index([departureDate])
}

model TravelDeskAuditLog {
  id              String               @id @default(cuid())
  workspaceId     String
  entityType      String
  entityId        String
  action          String
  oldValue        Json?
  newValue        Json?
  performedById   String
  createdAt       DateTime             @default(now())

  workspace       TravelDeskWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([entityType, entityId])
}

// ═══════════════════════════════════════════════════════════════
// STATION PAYMENT COLLECTION MODULE
// ═══════════════════════════════════════════════════════════════

enum StationPaymentMode {
  CASH
  UPI
}

enum StationUpiStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum StationCollectionStatus {
  COLLECTED
  CANCELLED
  REVERSED
}

enum StationHandoverStatus {
  PENDING
  HANDED_OVER
  CONFIRMED
  RECONCILED
}

enum ReceivingAccountType {
  COMPANY
  INDIVIDUAL
  BANK
  UPI
  CASH
  CARD
  OTHER
}

enum ReceivingAccountOwnership {
  COMPANY
  STAFF
  PARTNER
  INDIVIDUAL
  OTHER
}

// ── Approved accounts that can receive client & station payments ──
model PaymentReceivingAccount {
  id                  String                      @id @default(cuid())
  tenantId            String                      @default("default")
  accountName         String                      // Display name shown in dropdowns
  accountHolderName   String
  accountType         ReceivingAccountType        @default(COMPANY)
  ownershipType       ReceivingAccountOwnership?  @default(COMPANY)
  paymentMethods      String[]                    @default(["UPI", "BANK_TRANSFER"])
  bankName            String?
  accountNumber       String?
  maskedAccountNumber String?                     // e.g. XXXX9482
  ifsc                String?
  upiId               String?                     // Masked UPI ID: abc***@okaxis
  description         String?                     @db.Text
  linkedAdminId       String?                     // FK → Admin (for STAFF accounts)
  isApproved          Boolean                     @default(true)
  isActive            Boolean                     @default(true)
  createdByAdminId    String?
  approvedByAdminId   String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  linkedAdmin         Admin?                      @relation("AccountLinkedAdmin", fields: [linkedAdminId], references: [id], onDelete: SetNull)
  createdBy           Admin?                      @relation("AccountCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  approvedBy          Admin?                      @relation("AccountApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  collections         StationPaymentCollection[]
  clientPayments      OpsClientPayment[]
  vendorPayments      OpsVendorPayment[]          @relation("VendorPaymentPaidFromAccount")
  accountingEntries   AccountingEntry[]
  accountSubmissions  CollectionAccountSubmission[]

  @@index([tenantId])
  @@index([tenantId, isActive, isApproved])
}

// ── Track when collection account funds are submitted/transferred to company ──
model CollectionAccountSubmission {
  id                String                  @id @default(cuid())
  tenantId          String                  @default("default")
  accountId         String                  // FK → PaymentReceivingAccount
  amount            Float
  paymentMode       String                  // CASH, BANK_TRANSFER, UPI, CARD
  referenceNumber   String?
  notes             String?                 @db.Text
  recordedByAdminId String                  // FK → Admin (admin who recorded this submission)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  account           PaymentReceivingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedBy        Admin                   @relation("AccountSubmissionRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([accountId])
}

// ── One record per payment event — immutable once created ──
model StationPaymentCollection {
  id                   String                  @id @default(cuid())
  tenantId             String                  @default("default")
  receiptNumber        String                  @unique  // YC-PAY-2026-000001

  // Booking context
  bookingId            String                  // refs Booking.bookingId
  tripId               String
  departureDate        DateTime                @db.Date
  station              String
  platform             String?

  // Payment details
  paymentMode          StationPaymentMode
  amount               Float
  previousPaid         Float                   // Snapshot at collection time
  newTotalPaid         Float                   // previousPaid + amount (only for CASH or Verified UPI)
  newRemaining         Float
  paymentStatus        String                  // PAID | PARTIAL (booking payment status at time of record)

  // Collection metadata
  collectedByAdminId   String
  collectedAt          DateTime
  collectedFrom        String                  // Person's name
  collectedFromMobile  String?
  remarks              String?                 @db.Text
  proofImageUrl        String?

  // UPI-specific fields
  utrNumber            String?                 // UTR / Transaction ID (required for UPI)
  receivingAccountId   String?                 // FK → PaymentReceivingAccount
  upiVerificationStatus StationUpiStatus?      // Only for UPI payments
  verifiedByAdminId    String?
  verifiedAt           DateTime?

  // Status
  collectionStatus     StationCollectionStatus @default(COLLECTED)
  emailStatus          String                  @default("PENDING") // PENDING | SENT | FAILED
  emailSentAt          DateTime?

  // Reversal / Cancellation
  isReversed           Boolean                 @default(false)
  reversedAt           DateTime?
  reversedByAdminId    String?
  reversalReason       String?                 @db.Text

  // Cash handover linkage
  handoverId           String?

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  // Relations
  booking              Booking                 @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  collectedBy          Admin                   @relation("CollectedByAdmin", fields: [collectedByAdminId], references: [id])
  reversedBy           Admin?                  @relation("ReversedByAdmin", fields: [reversedByAdminId], references: [id], onDelete: SetNull)
  verifiedBy           Admin?                  @relation("VerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  receivingAccount     PaymentReceivingAccount? @relation(fields: [receivingAccountId], references: [id], onDelete: SetNull)
  handover             StationCashHandover?    @relation(fields: [handoverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
  @@index([tripId, departureDate])
  @@index([collectedByAdminId])
  @@index([utrNumber])
  @@unique([tenantId, utrNumber])  // Prevent duplicate UTR within tenant
}

// ── Physical cash handover from collector to Finance ──
model StationCashHandover {
  id                   String                @id @default(cuid())
  tenantId             String                @default("default")
  collectorId          String
  tripId               String
  departureDate        DateTime              @db.Date
  station              String
  amountExpected       Float                 // Sum of CASH collections by this collector
  amountHandedOver     Float                 @default(0)
  handoverStatus       StationHandoverStatus @default(PENDING)
  handoverRecipientId  String?               // Finance Admin who receives
  handoverAt           DateTime?
  handoverReference    String?
  remarks              String?               @db.Text
  shortageAmount       Float                 @default(0)
  excessAmount         Float                 @default(0)
  financeConfirmedById String?               // Must ≠ collectorId
  financeConfirmedAt   DateTime?
  reconciledById       String?               // Must ≠ collectorId
  reconciledAt         DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Relations
  collector            Admin                 @relation("HandoverCollector", fields: [collectorId], references: [id])
  handoverRecipient    Admin?                @relation("HandoverRecipient", fields: [handoverRecipientId], references: [id], onDelete: SetNull)
  financeConfirmedBy   Admin?                @relation("HandoverFinanceConfirm", fields: [financeConfirmedById], references: [id], onDelete: SetNull)
  reconciledBy         Admin?                @relation("HandoverReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)
  collections          StationPaymentCollection[]

  @@index([tenantId])
  @@index([collectorId])
  @@index([tripId, departureDate])
}

// ── Track when employee submits collected funds to YouthCamping ──
model EmployeeCollectionSubmission {
  id                String   @id @default(cuid())
  tenantId          String   @default("default")
  employeeAdminId   String   // FK → Admin (person who collected funds)
  amount            Float
  paymentMode       String   // CASH, BANK_TRANSFER, UPI
  referenceNumber   String?
  notes             String?
  recordedByAdminId String   // FK → Admin (admin who recorded this submission)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employeeAdmin     Admin    @relation("EmployeeSubmissions", fields: [employeeAdminId], references: [id], onDelete: Cascade)
  recordedBy        Admin    @relation("SubmissionRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeAdminId])
}

