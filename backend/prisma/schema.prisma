// ── NEW: Accounting Alert Dedupe Model ──
model AccountingAlertDedupe {
  id        String   @id @default(cuid())
  alertType String
  bookingId String
  sentAt    DateTime @default(now())

  @@unique([alertType, bookingId])
  @@index([bookingId])
}

