// ── VENDORS & RATES DIRECTORY ──

enum OpsSharingType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  FAMILY
}

enum OpsRateBasis {
  PER_PERSON
  PER_ROOM
}

enum OpsMealPlan {
  EP
  CP
  MAP
  AP
}

enum OpsSeasonType {
  STANDARD
  SEASON
  OFF_SEASON
}

enum OpsAddonRateBasis {
  PER_PERSON
  PER_MEAL
  PER_ROOM
  PER_DAY
  PER_VEHICLE
  PER_TENT
  FIXED
}

enum OpsAllocationStatus {
  PLANNED
  CONTACTED
  CONFIRMED
  CANCELLED
}


model OpsAccommodationRate {
  id               String         @id @default(cuid())
  vendorId         String
  propertyName     String?
  city             String?
  roomCategory     String?
  sharingType      OpsSharingType
  rateBasis        OpsRateBasis
  amount           Decimal        @db.Decimal(10, 2)
  mealPlan         OpsMealPlan    @default(EP)
  seasonType       OpsSeasonType  @default(STANDARD)
  validFrom        DateTime?      @db.Date
  validTo          DateTime?      @db.Date
  minimumOccupancy Int            @default(1)
  maximumOccupancy Int            @default(4)
  totalRooms       Int            @default(0)
  notes            String?        @db.Text
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  vendor      OpsVendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  allocations OpsDepartureVendorAllocation[]

  @@index([vendorId])
  @@index([city])
  @@index([sharingType])
}

// ── VEHICLE MASTER (per vendor) ──────────────────────────────────────────────
// Authoritative vehicle records for a transport vendor.
// This replaces hardcoded fleet data in the UI.
model OpsVendorVehicle {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  vendorId           String

  // Identity
  vehicleName        String    // e.g. "20 Seater Tempo Traveller"
  vehicleCode        String?   // internal ref code e.g. "PB-08-TR-2001"
  plateNumber        String?   // registration plate
  vehicleCategory    String    @default("TEMPO_TRAVELLER") // TEMPO_TRAVELLER | SUV | SEDAN | BUS | OTHER

  // Capacity
  advertisedCapacity Int       @default(17)
  sellableSeats      Int       @default(16)

  // Features
  hasAC              Boolean   @default(true)
  fuelType           String?   @default("Diesel")
  luggageCapacity    String?   // "3 Large Bags" or "150 KG"
  notes              String?   @db.Text

  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor             OpsVendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vehicleRates       OpsVehicleRate[]

  @@index([tenantId])
  @@index([vendorId])
}

// ── ROUTE PRICING GROUP ───────────────────────────────────────────────────────
// One contract header per route (e.g. "WINTER SPITI — Kotkapura → Kotkapura, 8 Days")
// Contains multiple per-vehicle rates below.
model OpsRoutePricingGroup {
  id                  String    @id @default(cuid())
  tenantId            String    @default("default")
  vendorId            String

  // Route identity
  routeName           String    // user-facing label e.g. "WINTER SPITI"
  tripName            String?   // trip/destination name e.g. "Spiti Valley"
  pickupLocation      String    // e.g. "Kotkapura"
  dropLocation        String    // e.g. "Kotkapura" (same = round trip)
  destination         String?   // primary destination area

  // Contract terms
  season              String?   // WINTER | SUMMER | MONSOON | ALL_YEAR
  durationDays        Int       @default(1)
  durationNights      Int       @default(0)
  pickupDropIncluded  Boolean   @default(true)

  // Validity
  validFrom           DateTime? @db.Date
  validTo             DateTime? @db.Date

  notes               String?   @db.Text
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vendor              OpsVendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vehicleRates        OpsVehicleRate[]

  @@index([tenantId])
  @@index([vendorId])
}

// ── VEHICLE RATE (per vehicle per route pricing group) ───────────────────────
// One row per vehicle type per route contract.
// e.g. 20-Seater = ₹80,000 / 18 sellable seats = ₹4,444 PP
model OpsVehicleRate {
  id                    String    @id @default(cuid())
  tenantId              String    @default("default")
  routePricingGroupId   String
  vehicleId             String    // FK → OpsVendorVehicle

  // Snapshot of vehicle name at time of creation (for display even if vehicle renamed)
  vehicleNameSnapshot   String

  // Pricing
  totalVehicleAmount    Decimal   @db.Decimal(12, 2)
  sellableSeats         Int       // can differ from OpsVendorVehicle.sellableSeats
  suggestedPP           Decimal?  @db.Decimal(12, 2) // computed = totalVehicleAmount / sellableSeats
  negotiatedPP          Decimal?  @db.Decimal(12, 2) // admin override

  // Passenger constraints
  minimumPassengers     Int?      @default(1)
  maximumPassengers     Int?      // null = full sellable capacity

  // Extra charges
  extraPickupDropAmount Decimal   @default(0) @db.Decimal(12, 2)
  extraDayAmount        Decimal   @default(0) @db.Decimal(12, 2)

  notes                 String?   @db.Text
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  routePricingGroup     OpsRoutePricingGroup @relation(fields: [routePricingGroupId], references: [id], onDelete: Cascade)
  vehicle               OpsVendorVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Prevent duplicate active rate for same vehicle in same route group
  @@unique([routePricingGroupId, vehicleId])
  @@index([tenantId])
  @@index([routePricingGroupId])
  @@index([vehicleId])
}


model OpsTransportRate {
  id                   String                         @id @default(cuid())
  vendorId             String
  tripCode             String?
  routeName            String?
  pickupLocation       String?
  dropLocation         String?
  numberOfDays         Int                            @default(1)
  seasonType           String?
  vehicleType          String
  advertisedCapacity   Int                            @default(17)
  sellableSeats        Int                            @default(17)
  totalVehicleCost     Decimal                        @db.Decimal(10, 2)
  driverAllowance      Decimal                        @default(0) @db.Decimal(10, 2)
  tollParkingIncluded  Boolean                        @default(false)
  extraPickupCharge    Decimal                        @default(0) @db.Decimal(10, 2)
  validFrom            DateTime?                      @db.Date
  validTo              DateTime?                      @db.Date
  notes                String?                        @db.Text
  active               Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  vendor      OpsVendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  allocations OpsDepartureVendorAllocation[]

  @@index([vendorId])
  @@index([tripCode])
}

model OpsVendorAdditionalCharge {
  id             String            @id @default(cuid())
  vendorId       String
  tripCode       String?
  chargeName     String
  chargeCategory String?
  rateBasis      OpsAddonRateBasis
  amount         Decimal           @db.Decimal(10, 2)
  unit           String?
  city           String?
  conditions     String?           @db.Text
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  vendor OpsVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model OpsDepartureVendorAllocation {
  id                  String              @id @default(cuid())
  departureId         String // represents tripId + departureDate (stable identity string e.g. "tripId_date")
  itineraryDayId      String? // references DayItinerary.id if needed
  vendorId            String
  accommodationRateId String?
  transportRateId     String?
  masterRate          Decimal?            @db.Decimal(10, 2)
  negotiatedRate      Decimal?            @db.Decimal(10, 2)
  finalBookedRate     Decimal?            @db.Decimal(10, 2)
  quantity            Int                 @default(1)
  numberOfRooms       Int                 @default(0)
  numberOfGuests      Int                 @default(0)
