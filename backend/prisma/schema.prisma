model OpsTripVendor {
  id        String   @id @default(cuid())
  tripId    String
  vendorId  String
  category  String?  // HOTEL, TRANSPORT, GUIDE, FOOD, OTHER
  preferred Boolean  @default(false)
  priority  Int      @default(0)
  active    Boolean  @default(true)
