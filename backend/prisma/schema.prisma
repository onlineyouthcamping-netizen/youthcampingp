  tenantId    String   @default("default")
  vendorId    String
  eventType   String   // CREATED, CONTRACT_UPLOADED, PRICE_UPDATED, TRIP_ASSIGNED, PAYMENT_MADE, RATING_ADDED, COMPLAINT_LOGGED
  description String   @db.Text
  performedBy String?
  createdAt   DateTime @default(now())

  vendor OpsVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vendorId])
}

// ── HOTEL BOOKINGS TRACKER ──
model OpsHotelBooking {
  id            String           @id @default(cuid())
  tenantId      String           @default("default")
  tripId        String
  departureDate DateTime         @db.Date
  vendorId      String?
  hotelName     String
  location      String?
  checkIn       DateTime?
  checkOut      DateTime?
  roomType      String?
  numberOfRooms Int              @default(1)
  confirmed     OpsBookingStatus @default(UNCONFIRMED)
  totalAmount   Float            @default(0)
  advancePaid   Float            @default(0)
  balanceAmount Float            @default(0)
  contactPerson String?
  contactPhone  String?
  notes         String?          @db.Text
  isLocked      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Snapshot Fields
  rateId           String?
  rateType         String?          @default("PER_ROOM_PER_NIGHT")
  doubleRate       Float?
  tripleRate       Float?
  quadRate         Float?
  singleRate       Float?
  extraBedRate     Float?
  childWithBed     Float?
  childWithoutBed  Float?
  mealPlanRate     Float?
  taxPercent       Float?           @default(0)
  rateValidFrom    DateTime?
  rateValidUntil   DateTime?
  rateSnapshotAt   DateTime?

  // Allocations
  pricingMethod    String?          @default("room-wise")
  doubleRoomsCount Int?             @default(0)
  tripleRoomsCount Int?             @default(0)
  quadRoomsCount   Int?             @default(0)
  extraPersonsCount Int?            @default(0)
  nightsCount      Int?             @default(1)

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  vendor OpsVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  overrides DepartureHotelRateOverride[]

  @@index([tenantId])
  @@index([tripId, departureDate])
}

// ── PERSISTENT VENDOR HOTEL RATES ──
model OpsVendorHotelRate {
  id              String    @id @default(cuid())
  tenantId        String    @default("default")
  vendorId        String
  rateName        String?
  rateType        String    @default("PER_ROOM_PER_NIGHT") // PER_ROOM_PER_NIGHT | PER_PERSON_PER_NIGHT
  doubleRate      Float?
  tripleRate      Float?
  quadRate        Float?
  singleRate      Float?
  extraBedRate    Float?
  childWithBed    Float?
  childWithoutBed Float?
  mealPlan        String?
  mealPlanRate    Float?
  taxPercent      Float?    @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor          OpsVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([validFrom, validUntil])
}

// ── DEPARTURE-SPECIFIC OVERRIDES ──
model DepartureHotelRateOverride {
  id                  String   @id @default(cuid())
  departureHotelId    String
  fieldName           String
  originalValue       Float
  overriddenValue     Float
  reason              String
  overriddenById      String
  createdAt           DateTime @default(now())

  departureHotel      OpsHotelBooking @relation(fields: [departureHotelId], references: [id], onDelete: Cascade)

  @@index([departureHotelId])
}

// ── ROOM INVENTORY (Available rooms for allocation) ──
model OpsRoomInventory {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  tripId        String
  departureDate DateTime @db.Date
  roomLabel     String
  roomType      String   @default("TWIN")
  genderGroup   String   @default("BOYS")
  capacity      Int      @default(2)
  hotelName     String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tripId, departureDate])
}

// ── TRANSPORT FLEET TRACKER ──
model OpsTransportFleet {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  tripId             String
  departureDate      DateTime  @db.Date
  vendorId           String?
  vehicleType        String
  vehicleNumber      String?                          // registration plate e.g. HP-01-AB-1234
  capacity           Int       @default(13)
  route              String?
  pickupPoints       String?
  dropPoints         String?
  reportingTime      String?                          // HH:MM — when vehicle should report
  departureTime      String?                          // HH:MM — scheduled departure
  confirmationStatus String    @default("UNCONFIRMED") // UNCONFIRMED | CONFIRMED | CANCELLED
  paymentDueDate     DateTime?
  totalAmount        Float     @default(0)
  advancePaid        Float     @default(0)
  balanceAmount      Float     @default(0)
  driverName         String?
  driverPhone        String?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trip        Trip                   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  vendor      OpsVendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  allocations OpsVehicleAllocation[]

  @@index([tenantId])
  @@index([tripId, departureDate])
}

// ── GUIDE PAYMENTS TRACKER ──
model OpsGuidePayment {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  tripId             String
  departureDate      DateTime  @db.Date
  guideAdminId       String?                          // FK → Admin (internal guide from directory)
  vendorId           String?                          // FK → OpsVendor type=GUIDE (external guide vendor)
  guideName          String                           // display name (from Admin.name or free-text)
  assignmentType     String    @default("PRIMARY_GUIDE") // PRIMARY_GUIDE | CO_GUIDE | LOCAL_GUIDE | SUPPORT_STAFF
  assignmentStatus   String    @default("ASSIGNED")   // ASSIGNED | ACCEPTED | CONFIRMED | DECLINED | REPLACED | CANCELLED
  startDate          DateTime? @db.Date               // guide availability start
  endDate            DateTime? @db.Date               // guide availability end
  reportingLocation  String?
  reportingTime      String?                          // HH:MM
  emergencyContact   String?
  daysWorked         Int       @default(1)
  agreedAmount       Float     @default(0)
  advancePaid        Float     @default(0)
  balanceAmount      Float     @default(0)
  paymentStatus      String    @default("PENDING")
  approvedById       String?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  guideAdmin Admin?     @relation("GuideAssignments", fields: [guideAdminId], references: [id])
  approvedBy Admin?     @relation("GuidePaymentApprovals", fields: [approvedById], references: [id])
  vendor     OpsVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tripId, departureDate])
}

// ── OPERATIONAL MISC EXPENSES ──
model OpsMiscExpense {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  tripId        String
  departureDate DateTime @db.Date
  category      String
  description   String
  amount        Float    @default(0)
  createdAt     DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, departureDate])
}

// ── SEAT MANAGEMENT CONFIG & ALERTS ──
model OpsSeatConfig {
  id             String   @id @default(cuid())
  tenantId       String   @default("default")
  tripId         String
  departureDate  DateTime @db.Date
  totalSeatsCap  Int      @default(30)
  alertThreshold Int      @default(25)
  blockedSeats   Int      @default(0)
  alertSent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@unique([tenantId, tripId, departureDate])
}

// ── TRIP SOP LIBRARY ──
model OpsSOPTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  destination String
  stage       String   @default("PRE_TRIP_7D")
  taskName    String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId, destination])
}

// ── TRIP-WISE SOP MASTER TEMPLATE ──
model OpsSopTemplate {
  id               String   @id @default(cuid())
  tenantId         String   @default("default")
  tripId           String
  name             String
  description      String?  @db.Text
  activeVersionId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  versions         OpsSopVersion[]
  checklists       OpsTripChecklist[]

  @@unique([tenantId, tripId])
  @@index([tenantId])
  @@index([tripId])
}

// ── TRIP-WISE SOP VERSION ──
model OpsSopVersion {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  templateId    String
  versionNumber Int      @default(1)
  versionLabel  String   @default("v1")
  status        String   @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  createdById   String?
  activatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template      OpsSopTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  taskTemplates OpsSopTaskTemplate[]
  checklists    OpsTripChecklist[]

  @@unique([templateId, versionNumber])
  @@index([tenantId])
  @@index([templateId])
}

// ── TRIP-WISE SOP TASK TEMPLATE ──
model OpsSopTaskTemplate {
  id               String   @id @default(cuid())
  tenantId         String   @default("default")
  versionId        String
  taskName         String
  description      String?  @db.Text
  stage            String   @default("PRE_TRIP_7D")
  relativeOffset   Int      @default(-7) // Days relative to departure date (e.g. -30, -7, 0, 1)
  priority         String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  isRequired       Boolean  @default(true)
  defaultAssignee  String?  @default("OPERATIONS") // OPERATIONS, GUIDE, TRANSPORT_DESK, SALES_EXEC, TICKETING, FINANCE
  instructions     String?  @db.Text
  verificationReq  String?  // VOUCHER, PHOTO, LOG, PNR
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  dependencyTaskId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version          OpsSopVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  checklists       OpsTripChecklist[]

  @@index([tenantId])
  @@index([versionId, stage])
}

// ── TRIP-WISE CHECKLIST ITEM (ACTUAL TASK INSTANCES FOR DEPARTURE) ──
model OpsTripChecklist {
  id                String   @id @default(cuid())
  tenantId          String   @default("default")
  tripId            String
  departureDate     DateTime @db.Date
  sopTemplateId     String?
  sopVersionId      String?
  sopTaskTemplateId String?
  source            String   @default("SOP") // SOP, MANUAL
  stage             String   @default("PRE_TRIP_7D")
  taskName          String
  relativeOffset    Int?
  isRequired        Boolean     @default(true)
  sortOrder         Int         @default(0)
  dependencyTaskId  String?
  isCompleted       Boolean     @default(false)
  completedById     String?
  completedAt       DateTime?
  notes             String?     @db.Text
  assignedTo        String?     // OPERATIONS, GUIDE, FINANCE, etc.
  priority          String      @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  dueDate           DateTime?
  status            String      @default("Pending") // Pending, In Progress, Completed, Overdue, Blocked, Skipped
  remarks           String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  trip              Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict)
  sopTemplate       OpsSopTemplate?     @relation(fields: [sopTemplateId], references: [id], onDelete: SetNull)
  sopVersion        OpsSopVersion?      @relation(fields: [sopVersionId], references: [id], onDelete: SetNull)
  sopTaskTemplate   OpsSopTaskTemplate? @relation(fields: [sopTaskTemplateId], references: [id], onDelete: SetNull)
  completedBy       Admin?              @relation("ChecklistCompletedByAdmin", fields: [completedById], references: [id], onDelete: Restrict)
  activities        OpsChecklistActivity[]

  @@index([tripId, departureDate, stage])
  @@index([sopVersionId])
  @@index([sopTaskTemplateId])
}

// ── CHECKLIST ITEM ACTIVITY LOG ──
model OpsChecklistActivity {
  id              String             @id @default(cuid())
  tenantId        String             @default("default")
  checklistItemId String
  action          OpsChecklistAction
  previousStatus  Boolean
  nextStatus      Boolean
  notes           String?            @db.Text
  actorId         String
  createdAt       DateTime           @default(now())

  checklist OpsTripChecklist @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  actor     Admin            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([checklistItemId])
}

// ── INCIDENT / ISSUE LOG ──
model OpsIncidentLog {
  id            String            @id @default(cuid())
  tenantId      String            @default("default")
  tripId        String
  departureDate DateTime          @db.Date
  title         String
  severity      IncidentSeverity  @default(MEDIUM)
  description   String            @db.Text
  resolution    String?           @db.Text
  reportedById  String
  incidentType  OpsIncidentType   @default(OTHER)
  status        OpsIncidentStatus @default(OPEN)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  trip       Trip                  @relation(fields: [tripId], references: [id], onDelete: Restrict)
  reportedBy Admin                 @relation("IncidentReportedByAdmin", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy Admin?                @relation("IncidentResolvedByAdmin", fields: [resolvedById], references: [id], onDelete: Restrict)
  activities OpsIncidentActivity[]

  @@index([tripId, departureDate])
}

// ── INCIDENT ACTIVITY LOG ──
model OpsIncidentActivity {
  id         String                    @id @default(cuid())
  tenantId   String                    @default("default")
  incidentId String
  action     OpsIncidentActivityAction
  notes      String?                   @db.Text
  actorId    String
  createdAt  DateTime                  @default(now())

  incident OpsIncidentLog @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actor    Admin          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([incidentId])
}

// ── AUTO ALLOCATION RUN & OVERRIDE MODELS ──
model OpsAllocationRun {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  tripId        String
  departureDate DateTime @db.Date
  version       Int      @default(1)
  status        String   @default("DRAFT") // DRAFT | CONFIRMED
  resultJson    Json
  actorId       String?
  createdAt     DateTime @default(now())

  trip      Trip                    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  actor     Admin?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  overrides OpsAllocationOverride[]

  @@index([tenantId, tripId, departureDate])
}

model OpsAllocationOverride {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  allocationRunId String
  targetType      String // VEHICLE | ROOM
  targetId        String
  beforeValue     Json?
  afterValue      Json
  reason          String   @db.Text
  actorId         String
  createdAt       DateTime @default(now())

  run   OpsAllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Restrict)
  actor Admin            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([allocationRunId])
}

model OpsVehicleAllocation {
  id               String   @id @default(cuid())
  tripId           String
  departureDate    DateTime @db.Date
  fleetId          String
  bookingId        String
  travelerName     String
  seatNumber       Int?
  allocationStatus String   @default("ACTIVE") // ACTIVE | CANCELLED
  routeSegment     String?                     // e.g. pickup-point tag
  pickupPoint      String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip    Trip              @relation(fields: [tripId], references: [id], onDelete: Restrict)
  fleet   OpsTransportFleet @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  booking Booking           @relation(fields: [bookingId], references: [bookingId], onDelete: Restrict)

  @@unique([tripId, departureDate, bookingId, travelerName]) // prevent duplicate passenger allocation
  @@index([tripId, departureDate])
  @@index([fleetId])
  @@index([bookingId])
}

model OpsRoomAllocation {
  id               String   @id @default(cuid())
  tripId           String
  departureDate    DateTime @db.Date
  roomNumber       String
  roomType         String
  genderGroup      String
  bookingId        String
  travelerName     String
  sharingType      String   @default("STANDARD") // TWIN|TRIPLE|QUAD|EXTRA_BED|COUPLE|SINGLE|GUIDE_STAFF|COMPLIMENTARY
  allocationStatus String   @default("ACTIVE")   // ACTIVE | CANCELLED | NIGHT_JOURNEY_BLOCKED
  hotelBookingId   String?                        // FK → OpsHotelBooking (nullable for backward compat)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [bookingId], onDelete: Restrict)

  @@unique([tripId, departureDate, bookingId, travelerName]) // prevent duplicate passenger allocation
  @@index([tripId, departureDate])
  @@index([hotelBookingId])
}

// ── DAY ITINERARY GRID (EXCEL SHEET MATCH) ──
model OpsDayItinerary {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  tripId             String
  departureDate      DateTime  @db.Date
  date               DateTime?
  dayTitle           String
  paxCount           Int       @default(0)
  hotelName          String?
  hotelVerified      Boolean   @default(false)
  vehicleType        String?
  vehicleVerified    Boolean   @default(false)
  remarks            String?   @db.Text
  guideDriverDetails String?
  guideVerified      Boolean   @default(false)
  checkInDone        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, departureDate])
}

// ── TRIP DETAILED EXPENSE GRID (EXCEL SHEET MATCH) ──
model OpsTripExpense {
  id            String    @id @default(cuid())
  tenantId      String    @default("default")
  tripId        String
  departureDate DateTime  @db.Date
  serviceDate   DateTime?
  activity      String
  paymentDate   DateTime?
  totalAmount   Float     @default(0)
  amountPaid    Float     @default(0)
  dueAmount     Float     @default(0)
  paymentStatus String    @default("Due")
  remarks       String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, departureDate])
}

// ── SOP LIBRARY (Destination operating instructions only) ──
model OpsSopLibrary {
  id           String    @id @default(cuid())
  tenantId     String    @default("default")
  destination  String
  title        String
  content      String    @db.Text
  isActive     Boolean   @default(true)
  createdById  String?
  updatedById  String?
  archivedAt   DateTime?
  archivedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  Admin? @relation("SopCreatedByAdmin", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  Admin? @relation("SopUpdatedByAdmin", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy Admin? @relation("SopArchivedByAdmin", fields: [archivedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([destination])
}

// ── TRIP LEADER ASSIGNMENT (Departure scoped) ──
model OpsTripLeader {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  tripId        String
  departureDate DateTime @db.Date

  leaderName  String
  leaderPhone String
  leaderType  OpsLeaderType @default(INTERNAL)
  isPrimary   Boolean       @default(false)
  notes       String?       @db.Text

  assignedById String?
  updatedById  String?
  archivedAt   DateTime?
  archivedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip       Trip                    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  assignedBy Admin?                  @relation("LeaderAssignedByAdmin", fields: [assignedById], references: [id], onDelete: Restrict)
  updatedBy  Admin?                  @relation("LeaderUpdatedByAdmin", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy Admin?                  @relation("LeaderArchivedByAdmin", fields: [archivedById], references: [id], onDelete: Restrict)
  activities OpsTripLeaderActivity[]

  @@unique([tenantId, tripId, departureDate, leaderPhone])
  @@index([tenantId, tripId, departureDate])
}

// ── TRIP LEADER ACTIVITY LOG ──
model OpsTripLeaderActivity {
  id                 String                  @id @default(cuid())
  tenantId           String                  @default("default")
  leaderAssignmentId String
  action             OpsLeaderActivityAction
  beforeValue        Json?
  afterValue         Json?
  notes              String?                 @db.Text
  actorId            String
  createdAt          DateTime                @default(now())

  leader OpsTripLeader @relation(fields: [leaderAssignmentId], references: [id], onDelete: Restrict)
  actor  Admin         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([leaderAssignmentId])
}

// ── ENUMS ──
enum OpsLeaderType {
  INTERNAL
  FREELANCE
}

enum OpsIncidentType {
  MEDICAL
  LOST_LUGGAGE
  HOTEL_ISSUE
  TRANSPORT_ISSUE
  GUEST_CONFLICT
  DOCUMENT_ISSUE
  OTHER
}

enum OpsIncidentStatus {
  OPEN
  RESOLVED
}

enum OpsChecklistAction {
  COMPLETE
  REOPEN
}

enum OpsLeaderActivityAction {
  ASSIGN
  UPDATE
  ARCHIVE
  RESTORE
}

enum OpsIncidentActivityAction {
  CREATE
  UPDATE
  RESOLVE
  REOPEN
  COMMENT
}

model BookingActivityLog {
  id                 String   @id @default(cuid())
  bookingId          String
  action             String
  details            String   @db.Text
  performedByAdminId String?
  createdAt          DateTime @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  performedBy Admin?  @relation("BookingActivityActor", fields: [performedByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
}

model BookingTask {
  id           String    @id @default(cuid())
  tenantId     String    @default("default")
  bookingId    String
  title        String
  description  String    @db.Text
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate      DateTime?
  assignedById String
  assignedToId String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignedBy Admin   @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  assignedTo Admin   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  @@index([bookingId])
  @@index([assignedById])
  @@index([assignedToId])
}

model UserNavState {
  id             String   @id @default(cuid())
  userId         String   @unique
  expandedModule String
  updatedAt      DateTime @updatedAt
}

model KnowledgeSection {
  id          String   @id @default(cuid())
  tripId      String
  tabKey      String
  title       String
  description String   @db.Text
  itemCount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId])
  @@index([tabKey])
}

model TripNotice {
  id        String   @id @default(cuid())
  tripId    String
  title     String
  body      String   @db.Text
  isMajor   Boolean  @default(false)
  author    String?
  createdAt DateTime @default(now())
  acks      TripNoticeAck[]

  @@index([tripId])
}

model TripNoticeAck {
  id        String   @id @default(cuid())
  noticeId  String
  userId    String
  userName  String
  ackedAt   DateTime @default(now())

  notice    TripNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
}

model EmailTemplate {
  id                 String   @id @default(cuid())
  tenantId           String   @default("default")
  name               String
  subject            String
  body               String   @db.Text
  category           String // e.g. "Booking", "Inquiry", "Ticketing", "General"
  isActive           Boolean  @default(true)
  defaultAttachments Json? // Array of files
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
}

model EmailLog {
  id       String @id @default(cuid())
  tenantId String @default("default")

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  inquiryId String?
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  trainTicketId String?
  trainTicket   TrainTicket? @relation(fields: [trainTicketId], references: [id], onDelete: Cascade)

  senderId String?
  sender   Admin?  @relation(fields: [senderId], references: [id], onDelete: SetNull)

  recipient    String
  ccCount      Int      @default(0)
  bccCount     Int      @default(0)
  subject      String
  body         String   @db.Text
  templateId   String?
  templateName String?
  attachments  Json? // Array of file metadata
  status       String   @default("PENDING") // SENT, FAILED
  error        String? // Failure reason
  isTest       Boolean  @default(false)
  sentAt       DateTime @default(now())

  @@index([bookingId])
  @@index([inquiryId])
  @@index([trainTicketId])
  @@index([senderId])
}

// ==========================================
// PACKAGE BUILDER MODULE
// ==========================================

// ── State / Region ──
model PackageState {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities PackageCity[]

  @@index([tenantId])
}

// ── Destination / City ──
model PackageCity {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  stateId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state         PackageState           @relation(fields: [stateId], references: [id], onDelete: Cascade)
  hotels        PackageHotel[]
  vehicles      PackageVehicle[]
  activities    PackageActivity[]
  transferFrom  PackageTransferRoute[] @relation("TransferFromCity")
  transferTo    PackageTransferRoute[] @relation("TransferToCity")
  itineraryDays PackageItineraryDay[]

  @@unique([tenantId, stateId, name])
  @@index([tenantId])
  @@index([stateId])
}

// ── Vendor (Package-specific) ──
model PackageVendor {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  name          String
  type          String // HOTEL | VEHICLE | ACTIVITY | MEALS | GUIDE | OTHER
  contactPerson String?
  email         String?
  phone         String?
  location      String?
  gstNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotels     PackageHotel[]
  vehicles   PackageVehicle[]
  activities PackageActivity[]
  meals      PackageMealPlan[]

  @@index([tenantId])
  @@index([type])
}

// ── Hotel / Resort ──
model PackageHotel {
  id                   String   @id @default(cuid())
  tenantId             String   @default("default")
  cityId               String
  name                 String
  category             String // Budget | Standard | Deluxe | Premium | Luxury
  roomType             String // Standard | Deluxe | Super Deluxe | Premium | Suite
  maxPeoplePerRoom     Int      @default(2)
  mealPlan             String // EP | CP | MAP | AP
  basePrice            Float    @default(0)
  weekendPrice         Float?
  peakSeasonPrice      Float?
  extraMattressPrice   Float?   @default(0)
  extraAdultPrice      Float?   @default(0)
  childWithBedPrice    Float?   @default(0)
  childWithoutBedPrice Float?   @default(0)
  images               String[] @default([])
  vendorId             String?
  contactName          String?
  contactPhone         String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  city    PackageCity          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  vendor  PackageVendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tariffs PackageHotelTariff[]

  @@index([tenantId])
  @@index([cityId])
  @@index([category])
}

// ── Seasonal Hotel Tariff ──
model PackageHotelTariff {
  id        String   @id @default(cuid())
  hotelId   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  roomRate  Float    @default(0)
  label     String? // "Peak Season", "Weekend", "Diwali", etc.

  hotel PackageHotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([startDate, endDate])
}

// ── Vehicle / Transportation ──
model PackageVehicle {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  cityId          String
  name            String // Ertiga, Innova, Crysta, Tempo Traveller, Bus, Volvo
  seatingCapacity Int
  isAc            Boolean  @default(true)
  image           String?
  vendorId        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city    PackageCity            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  vendor  PackageVendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tariffs PackageVehicleTariff[]

  @@index([tenantId])
  @@index([cityId])
}

// ── Vehicle Pricing ──
model PackageVehicleTariff {
  id                  String  @id @default(cuid())
  vehicleId           String
  priceType           String // PER_DAY | PER_KM | FIXED_ROUTE | AIRPORT | RAILWAY
  perDayRate          Float?
  perKmRate           Float?
  fixedRouteRate      Float?
  minKmPerDay         Int?    @default(0)
  driverAllowance     Float?  @default(0)
  fuelIncluded        Boolean @default(true)
  tollParkingIncluded Boolean @default(false)
  notes               String?

  vehicle PackageVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ── Transfer Route ──
model PackageTransferRoute {
  id               String   @id @default(cuid())
  tenantId         String   @default("default")
  fromCityId       String
  toCityId         String
  distanceKm       Float?
  travelTimeMins   Int?
  suggestedVehicle String?
  fixedRate        Float?
  perKmRate        Float?
  pickupDropNotes  String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromCity PackageCity @relation("TransferFromCity", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   PackageCity @relation("TransferToCity", fields: [toCityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fromCityId])
  @@index([toCityId])
}

// ── Activity / Sightseeing ──
model PackageActivity {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  cityId        String
  name          String
  adultRate     Float    @default(0)
  childRate     Float    @default(0)
  isShared      Boolean  @default(true)
  duration      String? // "2 hrs", "Half Day", "Full Day"
  description   String?
  includedItems String?  @db.Text
  excludedItems String?  @db.Text
  image         String?
  vendorId      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  city   PackageCity    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  vendor PackageVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([cityId])
}

// ── Meal Plan ──
model PackageMealPlan {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  vendorId        String?
  name            String // "EP", "CP", "MAP", "AP" or custom
  breakfastCost   Float?   @default(0)
  lunchCost       Float?   @default(0)
  dinnerCost      Float?   @default(0)
  perPersonPerDay Float?   @default(0)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor PackageVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// ── Package Draft / Quote ──
model PackageDraft {
  id       String @id @default(cuid())
  tenantId String @default("default")
  draftId  String @unique
  status   String @default("draft") // draft | template | quoted | converted

  // Customer
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?

  // Package details
  packageName     String?
  stateId         String?
  departureCity   String?
  travelStartDate DateTime? @db.Date
  travelEndDate   DateTime? @db.Date
  totalNights     Int       @default(0)
  totalDays       Int       @default(0)
  adults          Int       @default(0)
  children        Int       @default(0)
  couples         Int       @default(0)
  totalRooms      Int       @default(0)
  roomConfig      Json? // room allocation details
  specialNotes    String?   @db.Text
  inclusions      String?   @db.Text
  exclusions      String?   @db.Text
  terms           String?   @db.Text

  // Pricing (recalculated server-side)
  hotelCost     Float   @default(0)
  vehicleCost   Float   @default(0)
  transferCost  Float   @default(0)
  activityCost  Float   @default(0)
  mealCost      Float   @default(0)
  guideCost     Float   @default(0)
  trainCost     Float   @default(0)
  flightCost    Float   @default(0)
  miscCost      Float   @default(0)
  subtotal      Float   @default(0)
  discount      Float   @default(0)
  discountType  String? // percentage | fixed
  gstRate       Float   @default(5)
  gstAmount     Float   @default(0)
  serviceCharge Float   @default(0)
  totalAmount   Float   @default(0)

  // Internal vendor costs (hidden from sales)
  vendorHotelCost    Float @default(0)
  vendorVehicleCost  Float @default(0)
  vendorActivityCost Float @default(0)
  vendorMealCost     Float @default(0)
  vendorGuideCost    Float @default(0)
  estimatedMargin    Float @default(0)

  // Quote
  quoteNumber   String?
  quoteValidity String?   @default("48 hours")
  paymentTerms  String?   @default("50% advance, 50% before travel")
  quoteSentAt   DateTime?

  // Audit
  salesAdminId String?
  createdById  String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  salesAdmin    Admin?                @relation("SalesPackageDrafts", fields: [salesAdminId], references: [id], onDelete: SetNull)
  createdBy     Admin?                @relation("PackageDraftCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     Admin?                @relation("PackageDraftUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  itineraryDays PackageItineraryDay[]

  @@index([tenantId])
  @@index([status])
  @@index([salesAdminId])
  @@index([tenantId, status, createdAt(sort: Desc)])
}

// ── Itinerary Day ──
model PackageItineraryDay {
  id             String    @id @default(cuid())
  draftId        String
  dayNumber      Int
  date           DateTime? @db.Date
  stayCityId     String?
  title          String? // Optional custom title
  routeFrom      String?
  routeTo        String?
  distanceKm     Float?
  travelTimeMins Int?
  notes          String?   @db.Text

  draft    PackageDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  stayCity PackageCity?           @relation(fields: [stayCityId], references: [id], onDelete: SetNull)
  items    PackageItineraryItem[]

  @@index([draftId])
  @@index([dayNumber])
}

// ── Itinerary Item (service assigned to a day) ──
model PackageItineraryItem {
  id           String  @id @default(cuid())
  dayId        String
  serviceType  String // HOTEL | VEHICLE | TRANSFER | ACTIVITY | MEAL | GUIDE | TRAIN | FLIGHT | CUSTOM
  serviceId    String? // ID of the master record (PackageHotel.id, etc.)
  label        String // Display name
  description  String? @db.Text
  quantity     Int     @default(1)
  rate         Float   @default(0)
  amount       Float   @default(0)
  isVendorCost Boolean @default(false)
  sortOrder    Int     @default(0)
  metadata     Json? // Extra data (room type, meal plan, vehicle type, etc.)

  day PackageItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

// ── Package Activity Log (audit trail) ──
model PackageActivityLog {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  draftId    String?
  action     String
  details    String?  @db.Text
  actorId    String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([draftId])
}

// ==========================================
// TRAVEL DESK MODULE
// ==========================================

// ── TICKETING SOPs ──
model TicketingSop {
  id          String   @id @default(cuid())
  tripId      String
  category    String // e.g. "train", "flight", "bus", "cancellation"
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip  Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TicketingSopItem[]

  @@index([tripId])
  @@index([category])
}

model TicketingSopItem {
  id        String   @id @default(cuid())
  sopId     String
  title     String
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sop TicketingSop @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// ── TICKETING QUICK LINKS ──
model TicketingLink {
  id        String   @id @default(cuid())
  tripId    String
  label     String
  val       String
  icon      String
  linkUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ── ITINERARY (parent: supports multiple variants) ──
model Itinerary {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  isDefault Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip       Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days       ItineraryDay[]
  routeMaps  ItineraryRouteMap[]
  inclusions ItineraryInclusion[]
  exclusions ItineraryExclusion[]
  notes      ItineraryNote[]

  @@index([tripId])
}

model ItineraryDay {
  id          String   @id @default(cuid())
  itineraryId String
  dayNumber   String
  dayDate     String
  plan        String   @db.Text
  stay        String
  meals       String
  transport   String
  distance    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

model ItineraryRouteMap {
  id          String   @id @default(cuid())
  itineraryId String
  mapUrl      String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

model ItineraryInclusion {
  id          String   @id @default(cuid())
  itineraryId String
  text        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

model ItineraryExclusion {
  id          String   @id @default(cuid())
  itineraryId String
  text        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

model ItineraryNote {
  id          String   @id @default(cuid())
  itineraryId String
  title       String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

// ── TRIP SOPs (Travel Desk) ──
model TripSop {
  id              String   @id @default(cuid())
  tripId          String
  title           String
  description     String   @db.Text
  category        String
  icon            String
  applicableRoles Json?
  trigger         String?
  responsibleRole String?
  requiredInputs  Json?
  escalationPath  String?
  expectedOutput  String?
  reviewFrequency String?
  ownerId         String?
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip  Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripSopItem[]
  versions TripSopVersion[]

  @@index([tripId])
}

model TripSopVersion {
  id            String   @id @default(cuid())
  sopId         String
  version       Int
  snapshot      Json     // Contains complete SOP and ordered items
  changeComment String?
  authorId      String?
  createdAt     DateTime @default(now())

  sop           TripSop  @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([sopId, version])
  @@index([sopId, createdAt])
}

model TripSopItem {
  id        String   @id @default(cuid())
  sopId     String
  title     String
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sop TripSop @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// ── TRIP DOCUMENTS ──
model TripDocument {
  id               String   @id @default(cuid())
  tripId           String
  name             String
  category         String
  fileType         String
  size             String?
  addedBy          String
  dateAdded        DateTime @default(now())
  fileUrl          String?
  storageKey       String?
  storedFilename   String?
  checksum         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  title            String   @default("")
  version          Int      @default(1)
  visibility       String   @default("internal")
  validFrom        DateTime?
  validUntil       DateTime?
  status           String   @default("DRAFT")
  uploadedBy       String   @default("system")
  approvalDetails  Json?
  knowledgeItems   KnowledgeItem[]
  versions         TripDocumentVersion[]

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripDocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  storageKey       String?
  fileUrl          String?
  originalFilename String?
  storedFilename   String?
  mimeType         String?
  fileSize         String?
  checksum         String?
  version          Int
  metadata         Json?
  visibility       String
  status           String
  uploadedBy       String
  createdAt        DateTime @default(now())

  document         TripDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model KnowledgeItem {
  id            String        @id @default(cuid())
  tripId        String
  documentId    String?
  sourceDocName String
  pageNumber    Int
  title         String
  content       String        @db.Text
  category      String
  version       Int           @default(1)
  status        String        @default("DRAFT")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  document      TripDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([category])
  @@index([status])
}

model TravelQuestion {
  id             String    @id @default(cuid())
  tripId         String
  question       String    @db.Text
  answer         String?   @db.Text
  status         String    @default("OPEN")
  escalatedTo    String
  assignedToId   String?
  assignedToName String?
  createdBy      String
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([status])
}

// ── TRIP GALLERY ──
model TripGallery {
  id        String   @id @default(cuid())
  tripId    String
  title     String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// ── TRIP NOTES & UPDATES ──
model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  title     String
  content   String?  @db.Text
  category  String
  linkUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([category])
}

// ── ANNOUNCEMENTS ──
model Announcement {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  title     String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ── DEPARTURE-WISE ACTIVITIES ──
model OpsActivity {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  tripId             String
  departureDate      DateTime  @db.Date
  dayNumber          Int       @default(1)
  date               DateTime?
  name               String
  type               String
  startTime          String?
  endTime            String?
  location           String?
  description        String?   @db.Text
  responsibleGuideId String?
  responsibleStaff   String?
  vendorId           String?
  vendorName         String?
  estimatedCost      Float     @default(0)
  actualCost         Float     @default(0)
  maxParticipants    Int       @default(0)
  safetyInstructions String?   @db.Text
  requiredEquipment  String?   @db.Text
  status             String    @default("Planned") // Planned, Confirmed, In Progress, Completed, Cancelled
  remarks            String?   @db.Text
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trip             Trip       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  responsibleGuide Admin?     @relation("OpsActivityGuide", fields: [responsibleGuideId], references: [id])
  vendor           OpsVendor? @relation("OpsActivityVendor", fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([tripId, departureDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENTERPRISE MASTER ACTIVITY DIRECTORY (0-COUPLED)
// ─────────────────────────────────────────────────────────────────────────────

enum ActivityCategory {
  ADVENTURE
  WATER_SPORTS
  TREKKING
  CAMPING
  SIGHTSEEING
  CULTURAL
  OTHER
}

enum ActivityDifficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

model ActivityMaster {
  id                  String             @id @default(cuid())
  name                String             @unique // e.g. "River Rafting" (Zero duplication)
  category            ActivityCategory   @default(ADVENTURE)
  duration            String             @default("2 Hours") // "2 Hours", "Half Day", "Full Day"
  defaultCapacity     Int                @default(50)        @map("default_capacity")
  difficulty          ActivityDifficulty @default(MODERATE)
  minimumAge          Int                @default(16)        @map("minimum_age")
  medicalRestrictions String?            @db.Text            @map("medical_restrictions")
  equipmentRequired   String?            @db.Text            @map("equipment_required")
  insuranceRequired   Boolean            @default(true)      @map("insurance_required")
  gstPercentage       Float              @default(5.0)       @map("gst_percentage")
  description         String?            @db.Text
  photos              String[]           @default([])
  safetyInstructions  String?            @db.Text            @map("safety_instructions")
  cancellationPolicy  String?            @db.Text            @map("cancellation_policy")
  meetingPoint        String?            @map("meeting_point")
  latitude            Float?
  longitude           Float?
  emergencyContact    String?            @map("emergency_contact")
  status              String             @default("ACTIVE")  // ACTIVE, INACTIVE, SEASONAL_CLOSED
  pricingTiers        Json?              @map("pricing_tiers") // e.g. {"Basic":2500,"High Fly":4200,"VIP":6500}
  dynamicRates        Json?              @map("dynamic_rates") // e.g. {"Adult":500,"Child":300,"Guide":0}
  createdAt           DateTime           @default(now())     @map("created_at")
  updatedAt           DateTime           @updatedAt          @map("updated_at")

  contracts           ActivityVendorContract[]
  tripTemplates       TripActivityTemplate[]
  departureActivities DepartureActivity[]
  documents           ActivityDocument[]

  @@index([category, status])
  @@index([name])
  @@map("activity_masters")
}

model ActivityDocument {
  id          String         @id @default(cuid())
  activityId  String         @map("activity_id")
  title       String // e.g. "Safety SOP - River Rafting", "Permit Template"
  docType     String         @default("SAFETY_SOP") // SAFETY_SOP, EQUIPMENT_CHECKLIST, INSURANCE_POLICY, WAIVER
  fileUrl     String         @map("file_url")
  createdAt   DateTime       @default(now())        @map("created_at")

  activity    ActivityMaster @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, docType])
  @@map("activity_documents")
}

model ActivityVendorContract {
  id              String           @id @default(cuid())
  activityId      String           @map("activity_id")
  vendorId        String           @map("vendor_id")
  validFrom       DateTime         @map("valid_from")
  validTo         DateTime         @map("valid_to")
  seasonType      String           @default("REGULAR") // PEAK, REGULAR, OFF_SEASON
  adultNetCost    Float            @default(0)         @map("adult_net_cost")
  childNetCost    Float            @default(0)         @map("child_net_cost")
  minParticipants Int              @default(1)         @map("min_participants")
  maxParticipants Int              @default(50)        @map("max_participants")
  paymentTerms    String           @default("NET_30")  @map("payment_terms")
  terms           String?          @db.Text
  isPreferred     Boolean          @default(false)     @map("is_preferred")
  isBlacklisted   Boolean          @default(false)     @map("is_blacklisted")
  createdAt       DateTime         @default(now())     @map("created_at")
  updatedAt       DateTime         @updatedAt          @map("updated_at")

  activity        ActivityMaster   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  vendor          DirectoryVendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  departureRuns   DepartureActivity[]

  @@unique([activityId, vendorId, validFrom, validTo, seasonType])
  @@index([activityId])
  @@index([vendorId])
  @@map("activity_vendor_contracts")
}

model TripActivityTemplate {
  id                String         @id @default(cuid())
  tripId            String         @map("trip_id")
  dayNumber         Int            @default(1)         @map("day_number")
  activityId        String         @map("activity_id")
  isIncluded        Boolean        @default(true)      @map("is_included") // true = base inclusion, false = optional Add-On
  addonSellingPrice Float          @default(0)         @map("addon_selling_price")
  order             Int            @default(0)
  remarks           String?        @db.Text
  createdAt         DateTime       @default(now())     @map("created_at")
  updatedAt         DateTime       @updatedAt          @map("updated_at")

  trip              Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity          ActivityMaster @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([tripId, dayNumber, activityId])
  @@index([tripId, dayNumber])
  @@map("trip_activity_templates")
}

model DepartureActivity {
  id                     String                  @id @default(cuid())
  tripId                 String                  @map("trip_id")
  departureDate          DateTime                @db.Date              @map("departure_date")
  dayNumber              Int                     @default(1)           @map("day_number")
  activityId             String                  @map("activity_id")
  activityVendorContractId String?               @map("activity_vendor_contract_id")
  vendorId               String?                 @map("vendor_id")
  responsibleGuideId     String?                 @map("responsible_guide_id")
  scheduledTime          String?                 @default("10:00 AM")  @map("scheduled_time")
  status                 String                  @default("PLANNED") // DRAFT, PLANNED, VENDOR_REQUESTED, VENDOR_CONFIRMED, PAYMENT_PENDING, VOUCHER_SENT, READY, STARTED, COMPLETED, CANCELLED, RECONCILED
  agreedNetCost          Float                   @default(0)           @map("agreed_net_cost")
  sellingPrice           Float                   @default(0)           @map("selling_price")
  maxCapacity            Int                     @default(50)          @map("max_capacity")
  assignedBus            String?                 @map("assigned_bus")
  pricingTiers           Json?                   @map("pricing_tiers")
  dynamicRates           Json?                   @map("dynamic_rates")
  actualTotalCost        Float                   @default(0)           @map("actual_total_cost")
  voucherNumber          String?                 @unique               @map("voucher_number")
  remarks                String?                 @db.Text
  createdAt              DateTime                @default(now())       @map("created_at")
  updatedAt              DateTime                @updatedAt            @map("updated_at")

  activity               ActivityMaster          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  contract               ActivityVendorContract? @relation(fields: [activityVendorContractId], references: [id], onDelete: SetNull)
  vendor                 DirectoryVendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  responsibleGuide       Admin?                  @relation("DepartureActivityGuide", fields: [responsibleGuideId], references: [id], onDelete: SetNull)
  passengerAllocations   PassengerActivityAllocation[]

  @@index([tripId, departureDate])
  @@index([activityId])
  @@map("departure_activities")
}

model PassengerActivityAllocation {
  id                  String            @id @default(cuid())
  departureActivityId String            @map("departure_activity_id")
  bookingId           String            @map("booking_id")
  passengerIndex      Int               @default(0)     @map("passenger_index")
  passengerName       String?           @map("passenger_name")
  seatNumber          String?           @map("seat_number")
  isOpted             Boolean           @default(true)  @map("is_opted")
  addonAmountCharged  Float             @default(0)     @map("addon_amount_charged")
  paymentStatus       String            @default("INCLUDED") // INCLUDED, PAID, PENDING
  waiverSigned        Boolean           @default(false) @map("waiver_signed")
  isCompleted         Boolean           @default(false) @map("is_completed")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt      @map("updated_at")

  departureActivity   DepartureActivity @relation(fields: [departureActivityId], references: [id], onDelete: Cascade)
  booking             Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([departureActivityId, bookingId, passengerIndex])
  @@index([bookingId])
  @@map("passenger_activity_allocations")
}

// ── NEW: VENDOR PAYMENTS TRACKER ──
model OpsVendorPayment {
  id                 String    @id @default(cuid())
  tenantId           String    @default("default")
  tripId             String
  departureDate      DateTime  @db.Date
  vendorName         String
  category           String // Hotels, Transport, Activities, Meals, Guides, Local vendors, Other
  serviceDescription String?   @db.Text
  agreedAmount       Float     @default(0)
  advancePaid        Float     @default(0)
  remainingPayable   Float     @default(0)
  paymentDate        DateTime?
  paymentMode        String?
  transactionId      String?
  invoiceProof       String?
  status             String    @default("Not Paid") // Not Paid, Advance Paid, Partially Paid, Pending Approval, Paid, Rejected
  
  // Approval Workflow Fields
  approvalStatus          String    @default("PENDING") // PENDING, REVIEWED_FINANCE_CONTROLLER, APPROVED_FOUNDER, REJECTED
  reviewedByFinanceAt     DateTime?
  reviewedByFinanceId     String?
  approvedByFounderAt     DateTime?
  approvedByFounderId     String?
  requiresFounderApproval Boolean   @default(false)
  rejectionReason         String?   @db.Text
  rejectionAt             DateTime?
  rejectedById            String?
  
  // Proof Tracking
  invoiceFileUrl          String?
  advanceProofUrl         String?
  settlementProofUrl      String?

  paidBy              String?
  collectionAccountId String?
  remarks             String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trip              Trip                     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  collectionAccount PaymentReceivingAccount? @relation("VendorPaymentPaidFromAccount", fields: [collectionAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tripId, departureDate])
  @@index([collectionAccountId])
  @@index([approvalStatus])
}

// ── NEW: CLIENT RECEIPTS/PAYMENTS TRACKER ──
model OpsClientPayment {
  id                  String                   @id @default(cuid())
  tenantId            String                   @default("default")
  bookingId           String
  amount              Float                    @default(0)
  paymentMode         String?
  collectionAccountId String?
  transactionId       String?
  paymentDate         DateTime?
  proofUrl            String?
  status              String                   @default("Pending Verification") // Unpaid, Partially Paid, Paid, Pending Verification, Verified, Rejected, Refunded
  
