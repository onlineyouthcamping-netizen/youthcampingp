  contentType ContentType
  title       String
  body        String               @db.Text
  data        Json?
  status      KnowledgeStatus      @default(draft)
  version     Int                  @default(1)
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  trip   Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author Admin @relation("KnowledgeAuthor", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tripId, section])
  @@index([createdAt])
}

model TripSOP {
  id          String          @id @default(cuid())
  tripId      String
  title       String
  description String          @db.Text
  category    SOPCategory
  steps       Json
  version     Int             @default(1)
  status      KnowledgeStatus @default(draft)
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip   Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author Admin @relation("SOPAuthor", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, category])
}

model TripActivityLog {
  id          String             @id @default(cuid())
  tripId      String
  action      TripActivityAction
  section     String
  itemId      String?
  changes     Json?
  performedBy String
  createdAt   DateTime           @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor Admin @relation("ActivityLogActor", fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
}

// ==========================================
// ENTERPRISE RBAC ARCHITECTURE MODELS
// ==========================================

model Role {
  id             String   @id @default(cuid())
  tenantId       String   @default("default")
  name           String
  description    String?  @db.Text
  isSystem       Boolean  @default(false)
  isCustom       Boolean  @default(true)
  isArchived     Boolean  @default(false)
  status         String   @default("active")
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isCustom])
  @@index([isSystem])
}

model Permission {
  id           String   @id @default(cuid())
  module       String
  action       String   @unique
  name         String
  description  String?  @db.Text
  resourceType String?
  tier         String   @default("free")
  createdAt    DateTime @default(now())

  rolePermissions  RolePermission[]
  userPermissions  UserCustomPermission[]
  groupPermissions GroupPermission[]
  delegations      PermissionDelegation[]

  @@index([module])
  @@index([action])
}

model RolePermission {
  roleId       String
  permissionId String
  addedAt      DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserCustomPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  isDenied     Boolean   @default(false)
  grantedBy    String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([expiresAt])
}

model PermissionGroup {
  id          String   @id @default(cuid())
  name        String
  module      String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  permissions GroupPermission[]
}

model GroupPermission {
  groupId      String
  permissionId String

  group      PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
}

model PermissionDelegation {
  id           String    @id @default(cuid())
  fromUserId   String
  toUserId     String
  permissionId String
  delegatedAt  DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([expiresAt])
}

model RbacAuditLog {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  userId       String?
  userName     String?
  userEmail    String?
  action       String
  resourceType String?
  resourceId   String?
  details      String?  @db.Text
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RoleTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  permissionsJson Json
  tier            String   @default("free")
  category        String   @default("general")
  adoptionCount   Int      @default(0)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ==========================================
// YOUTHCAMPING BACKEND API MODELS
// ==========================================

model ApiTrip {
  id            String   @id
  title         String
  subtitle      String?
  location      String
  image         String
  galleryImages String[] @map("gallery_images")
  description   String   @db.Text
  price         Float
  currency      String   @default("INR")
  difficulty    String
  ageGroup      String?  @map("age_group")
  maxAltitude   String?  @map("max_altitude")
  durationNights Int     @default(0) @map("duration_nights")
  durationDays   Int     @default(0) @map("duration_days")
  slug          String   @unique
  month         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  details     TripDetail?
  travelModes TravelMode[]
  roomSharing RoomSharing[]
  itinerary   ItineraryItem[]
  inclusions  Inclusion[]
  exclusions  Exclusion[]
  stays       Stay[]
  highlights  Highlight[]
  reviews     ReviewItem[]
  faqs        Faq[]

  @@index([createdAt])
  @@index([month])
  @@map("trips")
}

model TripDetail {
  id              String   @id @default(cuid())
  tripId          String   @unique @map("trip_id")
  nights          Int
  days            Int
  month           String?
  departureDates  Json     @map("departure_dates")
  departureMonth  String[] @map("departure_month")
  trip            ApiTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_details")
}

model TravelMode {
  id          String  @id @default(cuid())
  tripId      String  @map("trip_id")
  name        String
  price       Float   @default(0)
  included    Boolean @default(false)
  description String? @db.Text
  trip        ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("travel_modes")
}

model RoomSharing {
  id          String  @id @default(cuid())
  tripId      String  @map("trip_id")
  type        String
  price       Float   @default(0)
  base        Boolean @default(false)
  description String? @db.Text
  trip        ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("room_sharing")
}

model ItineraryItem {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  day         Int
  title       String
  description String   @db.Text
  location    String?
  activities  String[] @default([])
  trip        ApiTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([day])
  @@map("itinerary")
}

model Inclusion {
  id     String  @id @default(cuid())
  tripId String  @map("trip_id")
  text   String
  icon   String?
  trip   ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("inclusions")
}

model Exclusion {
  id     String  @id @default(cuid())
  tripId String  @map("trip_id")
  text   String
  icon   String?
  trip   ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("exclusions")
}

model Stay {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  name      String
  location  String
  image     String?
  nights    Int      @default(1)
  amenities String[] @default([])
  tags      String[] @default([])
  trip      ApiTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("stays")
}

model Highlight {
  id     String  @id @default(cuid())
  tripId String  @map("trip_id")
  image  String
  title  String
  trip   ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("highlights")
}

model ReviewItem {
  id        String   @id @default(cuid())
  author    String
  avatar    String?
  date      String
  rating    Float    @default(5.0)
  text      String   @db.Text
  images    String[] @default([])
  tripId    String?  @map("trip_id")
  featured  Boolean  @default(false)
  tripName  String?  @map("trip_name")
  tripSlug  String?  @map("trip_slug")
  createdAt DateTime @default(now()) @map("created_at")
  trip      ApiTrip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([featured])
  @@index([date])
  @@map("reviews")
}

model Story {
  id          String   @id @default(cuid())
  title       String
  author      String
  avatar      String?
  readTime    Int      @map("read_time")
  image       String
  slug        String   @unique
  excerpt     String   @db.Text
  publishedAt String   @map("published_at")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([featured])
  @@index([publishedAt])
  @@map("stories")
}

model Destination {
  id    Int    @id @default(autoincrement())
  name  String
  image String
  order Int    @default(0)

  @@index([order])
  @@map("destinations")
}

model Faq {
  id       String  @id @default(cuid())
  tripId   String  @map("trip_id")
  question String
  answer   String  @db.Text
  trip     ApiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("faqs")
}

model Departure {
  id            String    @id @default(cuid())
  tenantId      String    @default("default")
  departureCode String    @unique
  tripId        String
  departureDate DateTime  @db.Date
  status        String    @default("Planning") // Planning | Ready | Confirmed | In_Progress | Completed | Cancelled
  notes         String?   @db.Text
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  confirmedBy Admin? @relation("DepartureConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([tripId, departureDate])
  @@index([tenantId, tripId, departureDate])
  @@map("departures")
}

// ==========================================
// FINANCE MODULE BACKEND MODELS
// ==========================================

model RefundTransaction {
  id                      String            @id @default(cuid())
  tenantId                String            @default("default")
  bookingId               String
  originalAmountPaid      Float             @default(0)
  refundReason            String            @default("CUSTOMER_CANCELLATION") // CUSTOMER_CANCELLATION, TRIP_RESCHEDULE, OVERPAYMENT, OPERATIONAL_ISSUE, DISPUTE, OTHER
  refundReasonText        String?           @db.Text
  refundMethod            String            @default("CASH_REFUND") // CASH_REFUND, CREDIT_NOTE, HYBRID
  refundAmount            Float             @default(0) // Cash / Bank transfer / UPI portion
  refundDate              DateTime?
  refundReference         String?           // Bank UTR / Cash reference
  creditNoteAmount        Float             @default(0) // Credit note portion
  creditNoteValidityStart DateTime?
  creditNoteValidityEnd   DateTime?
  creditNoteStatus        String            @default("ACTIVE") // ACTIVE, PARTIALLY_USED, EXHAUSTED, EXPIRED, CANCELLED
  refundPolicyApplied     String?
  status                  String            @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, PROCESSING, COMPLETED, REJECTED, FAILED, CANCELLED
  gatewayMetadata         Json?             // Metadata for payment mode, bank info, UTR
  createdById             String
  approvedById            String?
  approvedDate            DateTime?
  rejectionReason         String?           @db.Text
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  booking      Booking           @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  createdBy    Admin             @relation("RefundCreatedByAdmin", fields: [createdById], references: [id])
  approvedBy   Admin?            @relation("RefundApprovedByAdmin", fields: [approvedById], references: [id], onDelete: SetNull)
  creditUsages CreditNoteUsage[]

  @@index([tenantId])
  @@index([bookingId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model CreditNoteUsage {
  id                  String   @id @default(cuid())
  tenantId            String   @default("default")
  refundTransactionId String
  targetBookingId     String
  amountUsed          Float
  balanceBefore       Float
  balanceAfter        Float
  appliedById         String
  notes               String?  @db.Text
  createdAt           DateTime @default(now())

  refundTransaction RefundTransaction @relation(fields: [refundTransactionId], references: [id], onDelete: Cascade)
  targetBooking     Booking           @relation(fields: [targetBookingId], references: [bookingId], onDelete: Cascade)
  appliedBy         Admin             @relation("CreditNoteAppliedByAdmin", fields: [appliedById], references: [id])

  @@index([tenantId])
  @@index([refundTransactionId])
  @@index([targetBookingId])
  @@index([appliedById])
}

model Coupon {
  id                String             @id @default(cuid())
  tenantId          String             @default("default")
  code              String             @unique
  description       String?            @db.Text
  discountType      String             @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue     Float
  maxDiscountAmount Float?
  minBookingAmount  Float?
  applicableTripIds Json?              // Null = all trips, or ["tripId1", "tripId2"]
  maxUsesTotal      Int?
  maxUsesPerUser    Int?               @default(1)
  currentUsesCount  Int                @default(0)
  validFrom         DateTime
  validUntil        DateTime
  status            String             @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdBy   Admin              @relation("CouponCreatedByAdmin", fields: [createdById], references: [id])
  redemptions CouponRedemption[]

  @@index([tenantId])
  @@index([code])
  @@index([status])
  @@index([createdById])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  tenantId       String   @default("default")
  couponId       String
  bookingId      String
  customerPhone  String?
  originalAmount Float
  discountAmount Float
  finalAmount    Float
  redeemedAt     DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)

  @@index([tenantId])
  @@index([couponId])
  @@index([bookingId])
}

model Ticket {
  id                String    @id @default(cuid())
  tenantId          String    @default("default")
  bookingId         String?
  type              String    @default("TRAIN") // TRAIN, FLIGHT, BUS, CAB, OTHER
  pnr               String?
  ticketNumber      String?
  passengers        Json?
  documentUrl       String?
  provider          String?
  journeyDate       DateTime?
  arrivalDate       DateTime?
  source            String?
  destination       String?
  cost              Float     @default(0)
  packageAllowance  Float?
  ticketingMargin   Float?
  status            String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, ISSUED, CONFIRMED, CANCELLED, REFUNDED
  confirmationEmail String?
  notes             String?   @db.Text
  createdById       String
  verifiedById      String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  booking    Booking? @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  createdBy  Admin    @relation("TicketCreatedByAdmin", fields: [createdById], references: [id])
  verifiedBy Admin?   @relation("TicketVerifiedByAdmin", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
  @@index([pnr])
  @@index([type])
  @@index([status])
  @@index([journeyDate])
}

model ServiceRegistry {
  id              String    @id @default(cuid())
  tenantId        String    @default("default")
  bookingId       String
  serviceType     String    @default("TRAIN") // TRAIN, FLIGHT, VISA, HOTEL, INSURANCE, TRANSPORT, OTHER
  serviceName     String
  vendorId        String?
  costPrice       Float     @default(0)
  sellingPrice    Float     @default(0)
  status          String    @default("PENDING") // PENDING, BOOKED, VERIFIED, CANCELLED
  confirmationRef String?
  notes           String?   @db.Text
  assignedStaffId String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking       Booking @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  assignedStaff Admin?  @relation("ServiceAssignedToAdmin", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  verifiedBy    Admin?  @relation("ServiceVerifiedByAdmin", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
  @@index([serviceType])
  @@index([status])
  @@index([vendorId])
}

model TaskAllotment {
  id           String        @id @default(cuid())
  tenantId     String        @default("default")
  title        String
  description  String?       @db.Text
  taskType     String        @default("OTHER") // HOTEL_BOOKING, TRANSPORT_ARRANGE, VISA_FOLLOW_UP, GUIDE_CONFIRM, PAYMENT_COLLECT, SERVICE_VERIFY, REFUND_PROCESS, OTHER
  priority     String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String        @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED, CANCELLED
  bookingId    String?
  tripId       String?
  vendorId     String?
  serviceId    String?
  assignedToId String
  assignedById String
  deadline     DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  booking    Booking?      @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  assignedTo Admin         @relation("TaskAssignedToAdmin", fields: [assignedToId], references: [id])
  assignedBy Admin         @relation("TaskCreatedByAdmin", fields: [assignedById], references: [id])
  comments   TaskComment[]

  @@index([tenantId])
  @@index([bookingId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@index([priority])
  @@index([deadline])
}

model TaskComment {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  taskId     String
  authorId   String
  comment    String   @db.Text
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  task   TaskAllotment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Admin         @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([taskId])
  @@index([authorId])
}

model TripAccounting {
  id                String    @id @default(cuid())
  tenantId          String    @default("default")
  bookingId         String    @unique
  tripId            String?
  departureDate     DateTime?
  sellingPrice      Float     @default(0)
  discountApplied   Float     @default(0)
  couponDiscount    Float     @default(0)
  creditNoteApplied Float     @default(0)
  netRevenue        Float     @default(0)
  advancePaid       Float     @default(0)
  finalPayment      Float     @default(0)
  totalPaid         Float     @default(0)
  balanceDue        Float     @default(0)
  cashRefund        Float     @default(0)
  creditIssued      Float     @default(0)
  totalCost         Float     @default(0)
  grossProfit       Float     @default(0)
  paymentStatus     String    @default("PENDING")
  refundStatus      String    @default("NONE")
  isSnapshotClosed  Boolean   @default(false)
  snapshotClosedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@index([tripId])
  @@index([paymentStatus])
  @@index([refundStatus])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user Admin @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
}

// ── COMPLIANCE & AUDIT LOGGING FOR FINANCE ──
model FinanceAuditLog {
  id                String   @id @default(cuid())
  tenantId          String   @default("default")
  entityType        String   // CUSTOMER_PAYMENT, VENDOR_PAYMENT, STATION_PAYMENT, REFUND
  entityId          String
  tripId            String?
  action            String   // CREATED, REVIEWED_FC, APPROVED_FOUNDER, REJECTED, PROOF_UPLOADED, STATUS_CHANGED
  performedBy       String   // user ID
  performedByName   String   // user display name
  performedAt       DateTime @default(now())
  oldValue          String?  @db.Text
  newValue          String?  @db.Text
  changeDescription String   @db.Text
  reason            String?  @db.Text
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([performedAt])
}


